{
  "name": "studri",
  "version": "1.0.0",
  "description": "スタドリ学習アプリ",
  "private": true,
  "scripts": {
    "build": "vite build",
    "preview": "vite preview --outDir dist",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.app.json",
    "test": "pnpm run typecheck && pnpm run test:unit && pnpm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "bddgen && playwright test",
    "test:e2e:ui": "bddgen && playwright test --ui"
  },
  "keywords": [],
  "author": "",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "playwright-bdd": "^9.2.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=26"
  }
}
