{
  "name": "studri",
  "version": "1.0.0",
  "description": "スタドリ学習アプリの共有Playwright E2Eテスト",
  "private": true,
  "scripts": {
    "test": "pnpm run test:e2e",
    "test:e2e": "pnpm run typecheck && bddgen && playwright test",
    "typecheck": "tsc --noEmit",
    "test:e2e:ui": "bddgen && playwright test --ui"
  },
  "keywords": [],
  "author": "",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "playwright-bdd": "^9.2.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.8.1"
}
